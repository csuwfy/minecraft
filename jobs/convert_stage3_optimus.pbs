#!/bin/bash
#PBS -N combatvla_convert_s3
#PBS -q v1_large72
#PBS -l select=1:ncpus=64:mem=256gb
#PBS -l walltime=72:00:00
#PBS -j oe
#PBS -o logs/convert_stage3_optimus.log

set -euo pipefail

BASE=${BASE:-/path/to/combatvla-workspace}
REPO=${REPO:-$BASE/src/CombatVLA}
ENV=${ENV:-$BASE/envs/combatvla-train}
DATASETS=${DATASETS:-$BASE/datasets}
OUT=${OUT:-$REPO/data/minecraft_full}

mkdir -p "$OUT" "$BASE/logs"
cd "$REPO"

"$ENV/bin/python" -m training.convert_optimus_mgoa_stage3 \
  --root "$DATASETS/optimus2_mgoa" \
  --output-root "$OUT" \
  --train-count 100000000 \
  --val-count 10000 \
  --frame-stride 4 \
  --max-window-frames 4 \
  --skip-existing-frames

wc -l "$OUT"/train_stage3.jsonl "$OUT"/val_stage3.jsonl

